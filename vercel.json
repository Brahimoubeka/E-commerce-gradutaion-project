{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    // All API calls go to your Express app
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    // Everything else serves your static front-end
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
